# PostgreSQL (Neon). En local usa una rama de desarrollo, nunca producción.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secreto para firmar las cookies de sesión del personal y de acudientes.
# Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-este-valor"

# Opcional. URL pública del portal, sin barra final. Si se define, el mensaje
# de WhatsApp usa este enlace en lugar del sitio donde está el administrador.
# NEXT_PUBLIC_APP_URL="https://ejemplo.com"

# Opcionales. Solo los lee db/seed-users.ts. En producción son obligatorias.
# SEED_ADMIN_PASSWORD=""
# SEED_TEACHER_PASSWORD=""
